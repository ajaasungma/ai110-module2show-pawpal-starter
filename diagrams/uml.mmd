classDiagram
    class Owner {
        +str name
        +str email
        +list pets
        +add_pet(pet: Pet) Void
        +get_all_tasks() list
    }

    class Pet {
        +str name
        +str species
        +int age
        +str special_notes
    }

    class Task {
        +str name
        +int duration_mins
        +str priority
        +bool is_completed
        +mark_complete() Void
    }

    class Scheduler {
        +int max_time_budget_mins
        +list scheduled_tasks
        +generate_daily_plan(tasks: list) list
        +get_remaining_time() int
    }

    Owner "1" --> "0..*" Pet : owns
    Owner "1" --> "1" Scheduler : uses
    Scheduler "1" --> "0..*" Task : organizes